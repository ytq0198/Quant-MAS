# Copy to .env for local/server secrets. Do not commit .env.
# cp .env.example .env

QUANT_MAS_ENV=local

# v5 Phase 6 lightweight backend access control.
# Local development defaults to open mode. Server mode should use api_key.
QUANT_MAS_AUTH_MODE=open
# Format: key:role,key:role. Roles: viewer, researcher, reviewer, admin.
# Example only; use long random keys on the server.
QUANT_MAS_API_KEYS=
QUANT_MAS_AUDIT_WRITE_PATH=logs/backend_audit.jsonl
QUANT_MAS_PUBLIC_STATUS=true

# Stooq daily CSV download (required when --source stooq)
# Get key: https://stooq.com/q/d/?s=aapl.us&get_apikey (see mistakes.md M-009)
STOOQ_API_KEY=

# Optional external data sources. Keep real keys only in .env, never in git.
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
SEC_EDGAR_USER_AGENT=YourName your@email.com

# Optional embedding/vector/graph backends for future RAG extensions.
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
VECTOR_STORE=in_memory
QUANT_MAS_STORAGE_MODE=local_files
POSTGRES_DSN=
PGVECTOR_DSN=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Optional LLM provider for research/report narration. Keep real keys only in .env.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# M10 local vLLM (OpenAI-compatible endpoint on server; pytest uses mock)
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_API_KEY=

# Optional Hugging Face (M6 FinBERT/LoRA, server manual runs only). Keep token in .env only.
HF_TOKEN=
HF_HOME=
# WANDB_API_KEY=...          # optional, LoRA training
