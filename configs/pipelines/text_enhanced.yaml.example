pipeline_id: text_enhanced
version: 1
description: Dry-run recipe for real-news text-enhanced walk-forward research.
metric_families:
  - audit
  - training
  - walk_forward
nodes:
  - id: fetch_real_news
    tool_name: data_summary
    script: scripts/fetch_real_news.py
    metric_family: audit
    dry_run_stub:
      source: finnhub
      note: no network in dry-run
  - id: align_real_news
    tool_name: data_summary
    script: scripts/align_real_news.py
    metric_family: audit
    depends_on: [fetch_real_news]
  - id: train_text_model
    tool_name: train_model
    script: scripts/train_text_model.py
    metric_family: training
    depends_on: [align_real_news]
    dry_run_stub:
      mode: finbert_baseline
  - id: audit_text_signals
    tool_name: data_summary
    script: scripts/audit_text_signals.py
    metric_family: audit
    depends_on: [train_text_model]
    dry_run_stub:
      requires_coverage_ratio: true
  - id: feature_build
    tool_name: pipeline
    script: scripts/build_features.py
    metric_family: audit
    depends_on: [audit_text_signals]
    dry_run_stub:
      text_signal_fillna: 0
  - id: walk_forward_eval
    tool_name: backtest
    script: scripts/run_walk_forward.py
    metric_family: walk_forward
    depends_on: [feature_build]
    allowed_metrics_prefix: ["oos."]
  - id: compare_experiments
    tool_name: report
    script: scripts/compare_experiments.py
    metric_family: audit
    depends_on: [walk_forward_eval]
