pipeline_id: ml_baseline
version: 1
description: Dry-run recipe for the ML walk-forward baseline research flow.
metric_families:
  - audit
  - training
  - walk_forward
nodes:
  - id: data_check
    tool_name: data_summary
    script: scripts/download_data.py
    metric_family: audit
    dry_run_stub:
      action: validate_local_data
  - id: feature_build
    tool_name: pipeline
    script: scripts/build_features.py
    metric_family: audit
    depends_on: [data_check]
  - id: train_model
    tool_name: train_model
    script: scripts/train_model.py
    metric_family: training
    depends_on: [feature_build]
  - id: walk_forward_eval
    tool_name: backtest
    script: scripts/run_walk_forward.py
    metric_family: walk_forward
    depends_on: [train_model]
    allowed_metrics_prefix: ["oos."]
  - id: compare_experiments
    tool_name: report
    script: scripts/compare_experiments.py
    metric_family: audit
    depends_on: [walk_forward_eval]
  - id: report
    tool_name: report
    script: scripts/generate_report.py
    metric_family: audit
    depends_on: [compare_experiments]
