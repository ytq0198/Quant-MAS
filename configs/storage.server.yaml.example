raw_data_dir: /home/<USER>/quant-mas/datasets/raw
processed_data_dir: /home/<USER>/quant-mas/datasets/processed
features_dir: /home/<USER>/quant-mas/datasets/features
models_dir: /home/<USER>/quant-mas/models
reports_dir: /home/<USER>/quant-mas/reports
logs_dir: /home/<USER>/quant-mas/logs
